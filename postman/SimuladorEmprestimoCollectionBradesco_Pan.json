          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valor_emprestimo\": 10000,\n  \"institucoes\": [237],\n  \"convenios\": [237],\n  \"parcela\": 24\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/simulacoes",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "simulacoes"]
        }
      }
    }
  ]
